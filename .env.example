# Copy to .env and adjust as needed:
#   cp .env.example .env

# Database (Homebrew PostgreSQL on localhost; defaults match database.yml)
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# SPEND_LENS_DATABASE_PASSWORD=your_password

# AI Provider Configuration ('ollama', 'gemini', or 'openai')
# - 'ollama' = local LLM (free, private, single-shot only — no agentic tool use)
# - 'gemini' = Google Gemini API (recommended for agentic mode)
# - 'openai' = OpenAI API (recommended for agentic mode)
AI_PROVIDER=ollama

# Ollama Settings (used if AI_PROVIDER=ollama)
# Use llama3.1:8b or mistral:7b for better quality (llama3.2:3b is faster but less accurate)
# Local: 127.0.0.1 — Docker Compose: host.docker.internal (set automatically in compose)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Google Gemini Settings (used if AI_PROVIDER=gemini)
# In dev: paste a free-tier AI Studio key (data may be used for training — do NOT use real data).
# In prod: switch to a paid-tier API key from Google AI Studio (billed) or Vertex AI.
# Current models (May 2026): gemini-2.5-flash (recommended), gemini-2.0-flash,
# gemini-2.5-pro, gemini-3.5-flash. Avoid gemini-1.5-* — deprecated/removed.
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI Settings (used if AI_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ---- Agentic AI controls ---------------------------------------------------
# Agent mode lets Savvy call tools (search_transactions, monthly_summary, ITR
# readiness, propose_recategorize, etc.) instead of stuffing one big context.
# Only Gemini and OpenAI support function calling; Ollama silently falls back
# to single-shot mode.
#
# Per-user toggles also exist in /settings — these env vars are global gates.
# AI_AGENTIC_ENABLED=true            # set to 'false' to disable globally
# AI_AGENTIC_MAX_STEPS=6             # 1..12 — caps tool calls per question

# Optional: enable Solid Queue in Puma (background jobs)
# SOLID_QUEUE_IN_PUMA=1

# macOS: set this if Solid Queue crashes with objc_initializeAfterForkError
# OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# Large investment imports run in background (bytes / row estimate)
# LARGE_IMPORT_BYTES=512000
# LARGE_IMPORT_ROWS=400
# IMPORT_MAX_PREVIEW_ROWS=2000

# Optional AI polish on CDSL CAS imports. The regex parser truncates names
# for column-wrapped securities (e.g. "HDFCAMCLTD" instead of "HDFC Mid-Cap
# Opportunities Fund - Direct Plan - Growth"). When enabled, an AI pass
# rewrites the description using the ISIN as the authoritative identifier.
# Defaults to OFF because models (incl. Gemini 2.5 Flash) sometimes
# hallucinate MF scheme names confidently. Only enable if you trust your
# provider and skim the preview before importing. Numbers/dates/ISINs are
# never touched by AI — only the human-readable description.
# CDSL_CAS_AI_ENRICH=true

# Optional: Redis for Action Cable (production)
# REDIS_URL=redis://localhost:6379/1
