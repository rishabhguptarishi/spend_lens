#!/bin/bash -e

cd /rails

bundle check >/dev/null 2>&1 || bundle install
if [ -f package.json ]; then
  npm install --no-audit --no-fund
fi

# Wait for Postgres (compose healthcheck should cover this; retry for race on first boot)
if [ -n "${DATABASE_HOST}" ]; then
  until pg_isready -h "$DATABASE_HOST" -U "${DATABASE_USER:-postgres}" >/dev/null 2>&1; do
    echo "Waiting for database at ${DATABASE_HOST}..."
    sleep 1
  done
fi

bin/rails db:prepare

case "${1:-server}" in
  server)
    echo "Starting Vite on :3036 and Rails on :3000"
    bin/vite dev &
    exec bin/rails server -b 0.0.0.0 -p 3000
    ;;
  bash|sh)
    exec "${@}"
    ;;
  *)
    exec "${@}"
    ;;
esac
